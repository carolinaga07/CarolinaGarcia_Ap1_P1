@page "/autores"
@inject AutoresService autoresService

<PageTitle>Registro de Autores</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Autores</h5>
            <a href="/autores/create" class="btn btn-primary"><span class="bi bi-plus"></span>Crear</a>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button> 
                    </div>
                </div>
                @*Quickgrid*@
                <QuickGrid Items="ListaAutores.AsQueryable()" class="table table-hover">
                    <PropertyColumn Property="a => a.AutorId" title="AutorId" Sortable="true" />
                    <PropertyColumn Property="a => a.Nombres" title="Nombres" Sortable="true" />
                    <PropertyColumn Property="a => a.Nacionalidad" title="Nacionalidad" Sortable="true" />
                    <PropertyColumn Property="a => a.FechaNacimiento" title="Fecha de Nacimiento" Sortable="true" />
                    <PropertyColumn Property="a => a.Sueldo" title="Sueldo" Sortable="true" />
                    <TemplateColumn>
                        <a href="/autores/edit/@context.AutorId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        @*Footer*@
        <div class="card-footer d-flex justify-content-between">
            <label>Cantidad:@ListaAutores.Count()</label>
            <label>Total:@ListaAutores.Sum(a => a.Sueldo).ToString("N2")</label>
        </div> 
    </div>
</div>



@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public List<Autores> ListaAutores = new List<Autores>();

    protected override async Task OnInitializedAsync()
    {
        ListaAutores = await autoresService.GetList(a => a.AutorId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() == "")
        {
            ListaAutores = await autoresService.GetList(a => a.AutorId > 0);
            return;
        }
        if(Filtro == "Nombres")
        {
            ListaAutores = await autoresService.GetList(a => a.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
        }
        if (Filtro == "Nacionalidad")
        {
            ListaAutores = await autoresService.GetList(a => a.Nacionalidad.ToLower().Contains(ValorFiltro.ToLower()));
        }
    }
}
