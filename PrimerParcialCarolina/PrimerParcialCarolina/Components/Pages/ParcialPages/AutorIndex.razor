@page "/autores"
@inject AutoresService autoresService
@inject ToastService toastService

<PageTitle>Registro de Model1</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de model1</h5>
            <a href="/autores/create" class="btn btn-primary"><span class="bi bi mt-3"></span>Crear</a>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button> 
                    </div>
                </div>
                @*Quickgrid*@
                <QuickGrid Items="ListaAutores.AsQueryable()" class="table table-hover">
                    <PropertyColumn Property="a => a.AutorId" title="AutorId" Sortable="true" />
                    <PropertyColumn Property="a => a.Nombres" title="Nombres" Sortable="true" />
                    <PropertyColumn Property="a => a.Nacionalidad" title="Nacionalidad" Sortable="true" />
                    <PropertyColumn Property="a => a.FechaNacimiento" title="Fecha de Nacimiento" Sortable="true" />
                    <PropertyColumn Property="a => a.Sueldo" title="Sueldo" Sortable="true" />
                    <TemplateColumn>
                        <a href="/autores/edit/@context.AutorId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        <button type="button" class="btn btn-outline-danger bi bi-trash" data-bs-toggler="modal" data-bs-target="#modalEliminar" @onclick="()=> mostrarModal(context)"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        @*Footer*@
        <div class="card-footer d-flex justify-content-between">
            <label>Cantidad:@ListaAutores.Count()</label>
            <label>Total:@ListaAutores.Sum(a => a.Sueldo).ToString("N2")</label>
        </div> 
    </div>
</div>

@*ModalEliminar*@
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminacion</h5>
                <button type="button" class="btn btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if(AutorAEliminar != null)
                {
                    <p>Deseas eliminar el siguiente autor?</p>
                    <p>AutorId:@AutorAEliminar.AutorId</p>
                    <p>Nombres:@AutorAEliminar.Nombres</p>
                    <p>Nacionalidad:@AutorAEliminar.Nacionalidad</p>
                    <p>Fecha de nacimiento:@AutorAEliminar.FechaNacimiento</p>
                    <p>Sueldo:@AutorAEliminar.Sueldo</p>
                }
            </div>
            <div class="modal-footer text-center mt-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="ConfirmarEliminar"> Eliminar</button>
            </div>
        </div>
    </div>
</div>


@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public List<Autores> ListaAutores = new List<Autores>();
    private Autores? AutorAEliminar;

    public async Task OnInitializedAsync()
    {
        ListaAutores = await autoresService.GetList(a => a.AutorId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() == "")
        {
            ListaAutores = await autoresService.GetList(a => a.AutorId > 0);
            return;
        }
        if(Filtro == "Nombres")
        {
            ListaAutores = await autoresService.GetList(a => a.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
        }
        if (Filtro == "Nacionalidad")
        {
            ListaAutores = await autoresService.GetList(a => a.Nacionalidad.ToLower().Contains(ValorFiltro.ToLower()));
        }

    }

    private void mostrarModal(Autores autores)
    {
        AutorAEliminar = autores;
    }

    private async Task ConfirmarEliminar()
    {
        if(AutorAEliminar == null)
        {
            return;
        }
        if(await autoresService.Eliminar(AutorAEliminar.AutorId))
        {
            toastService.ShowSuccess("Autor eliminado correctamente.");
            await autoresService.GetList(a => a.AutorId > 0); 
        }
        else
        {
            toastService.ShowError("Autor no eliminado.");
        }
    }
}
