@page "/autores/edit/{AutorId:int}"
@rendermode InteractiveServer
@inject AutoresService autoresService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Edit</PageTitle>
<EditForm Model="autores" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Autor</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>AutorId</strong></label>
                    <InputNumber class="form-control" @bind-Value="autores.AutorId" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="autores.Nombres"></InputText>
                    <ValidationMessage For="() => autores.Nombres"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>Nacionalidad</strong></label>
                    <InputText class="form-control" @bind-Value="autores.Nacionalidad"></InputText>
                    <ValidationMessage For="() => autores.Nacionalidad"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="autores.FechaNacimiento"></InputDate>
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>Sueldo</strong></label>
                    <InputNumber class="form-control" @bind-Value="autores.Sueldo"></InputNumber>
                    <ValidationMessage For="() => autores.Sueldo"></ValidationMessage>
                </div>
            </div>
            <div class="card-footer text-center mt-2">
                <a href="/autores" class="btn btn-secondary"><span class="bi bi-arrow-left"> Volver</span></a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>


@code {
    [Parameter]
    public int AutorId { get; set; }

    private Autores autores = new Autores();

    protected override async Task OnInitializedAsync()
    {
        autores = await autoresService.Buscar(AutorId) ?? new Autores();
    }

    private async Task Modificar()
    {
        if (await autoresService.ExisteNombre(autores.Nombres, autores.AutorId))
        {
            toastService.ShowError("Ya existe un autor con ese nombre");
            return;
        }

        var Exito = await autoresService.Guardar(autores);
        if (Exito)
        {
            toastService.ShowSuccess("El autor fue modificado correctamente.");
            navigationManager.NavigateTo("/autores");
        }
        else
        {
            toastService.ShowError("Hubo un problema al modificar el autor.");
        }

    }
}
